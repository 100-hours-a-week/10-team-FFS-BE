# 비교 측정 전용: 멀티스테이지 없이 JDK 이미지 하나로 빌드+실행까지 다 하는 버전.
# 실제로 쓰지 않음 - Dockerfile.api(멀티스테이지)와의 이미지 크기 차이를 실측하기 위한 용도.
FROM eclipse-temurin:21-jdk

LABEL description="API Server (JDK single-stage, for size comparison only)"

WORKDIR /workspace

COPY gradlew settings.gradle build.gradle ./
COPY gradle gradle
COPY module-common/build.gradle module-common/build.gradle
COPY module-domain/build.gradle module-domain/build.gradle
COPY module-api/build.gradle module-api/build.gradle
RUN ./gradlew :module-api:dependencies --no-daemon || true

COPY module-common/src module-common/src
COPY module-domain/src module-domain/src
COPY module-api/src module-api/src
RUN ./gradlew :module-api:bootJar -x test --no-daemon

RUN groupadd -r spring && useradd -r -g spring spring
RUN mkdir -p /app/logs
WORKDIR /app
RUN cp /workspace/module-api/build/libs/api.jar app.jar && chown -R spring:spring /app

USER spring

ENV TZ=Asia/Seoul \
    JAVA_OPTS="-XX:+UseContainerSupport \
               -XX:MaxRAMPercentage=70.0 \
               -XX:+UseG1GC \
               -XX:+UseStringDeduplication \
               -Djava.security.egd=file:/dev/./urandom"

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
